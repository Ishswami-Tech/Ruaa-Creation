# Server only. Never prefix these with NEXT_PUBLIC_.
# Use the pooled PostgreSQL URL at runtime; retain TLS verification.
DATABASE_URL=""
# Optional direct PostgreSQL URL for migrations if the provider uses a pooler.
DIRECT_URL=""

# Public canonical origin. Set only after the custom domain is connected.
NEXT_PUBLIC_SITE_URL="https://ruaa-creation.vercel.app"
# Optional ownership verification tokens from your Search Console / Bing account.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
