{
  "name": "ruaa-creation",
  "version": "1.0.0",
  "private": true,
  "description": "Ruaa Creation - ready-to-wear sarees, designer blouses, tassels, western and traditional wear, customised outfits and hand painting.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check:launch": "node scripts/check-launch.cjs",
    "release": "npm run check:launch && npm run lint && npm test && npm run build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-catalogue.ts",
    "admin:account": "tsx scripts/admin-account.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "start": "next start",
    "test:seo": "tsx scripts/test-seo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
